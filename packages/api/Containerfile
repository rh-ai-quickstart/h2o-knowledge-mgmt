FROM registry.access.redhat.com/ubi9/python-312:latest

WORKDIR /opt/app-root/src

COPY --chown=1001:0 packages/api/pyproject.toml ./pyproject.toml
COPY --chown=1001:0 packages/api/src ./src

RUN pip install --no-cache-dir .

EXPOSE 8000

CMD ["uvicorn", "h2o_knowledge_mgmt_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
